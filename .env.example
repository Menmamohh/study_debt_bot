# Собственный токен от @BotFather. Не публикуй заполненный .env.
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Числовой Telegram ID администратора; обязателен при первой настройке.
ADMIN_ID=

# Необязательные настройки. Значения по умолчанию описаны в DEPLOY.md.
# DB_PATH=/app/data/debts.db
# GDRIVE_FOLDER_ID=YOUR_PUBLIC_FOLDER_ID
# BOT_TIMEZONE=Europe/Minsk
# SCHEDULE_CUTOFF_HOUR=17
# SCHEDULE_SATURDAY_CUTOFF_HOUR=14
# BOT_LOG_FILE=/app/data/bot.log

# Gemini запускается только по действию администратора.
# Без ключа подготовка черновиков использует установленный Tesseract.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.8-flash
